[worldserver]

########################################
# AH INJECTOR
########################################

# AHInjector.Enabled
#     Description: Enable the AH Injector module
#     Default:     1 - Enabled
#                  0 - Disabled
AHInjector.Enabled = 1

# AHInjector.UpdateInterval
#     Description: How often the injector runs its cycle (in milliseconds)
#     Default:     300000 (5 minutes)
AHInjector.UpdateInterval = 300000

# AHInjector.ItemsPerCycle
#     Description: Maximum number of items to inject per cycle
#     Default:     10
AHInjector.ItemsPerCycle = 10

# AHInjector.ItemList
#     Description: Comma-separated list of items to inject
#     Format: "entry:count:minBid:buyout:durationHours"
#     Example: "19019:1:100000:200000:48, 44151:1:500000:1000000:48"
#     Default:     "" (empty - no items injected)
AHInjector.ItemList = "19019:1:1000000:2000000:48, 44151:1:25000000:50000000:48, 43954:1:25000000:50000000:48"

# AHInjector.InjectorAccount
#     Description: Account name for the virtual injector character
#     Default:     "AHInjector"
AHInjector.InjectorAccount = "AHInjector"

# AHInjector.InjectorGuid
#     Description: Fixed GUID for the injector character (must match database)
#     Default:     1002000
AHInjector.InjectorGuid = 1002000

# AHInjector.InjectorName
#     Description: Character name for the injector
#     Default:     "AHInjector"
AHInjector.InjectorName = "AHInjector"

# AHInjector.MaxListingsPerItem
#     Description: Maximum number of concurrent listings of the same item entry.
#                  The injector keeps re-injecting until this count is active, so the AH stays stocked.
#     Default:     2
AHInjector.MaxListingsPerItem = 2

# AHInjector.PriceVariancePercent
#     Description: Random price jitter applied to injected listings (percentage of configured price)
#     Default:     20.0
AHInjector.PriceVariancePercent = 20.0

# AHInjector.RandomizeDuration
#     Description: Randomly pick auction duration from the standard 12/24/48h tiers
#     Default:     1 - Enabled
#                  0 - Disabled (use the duration from ItemList)
AHInjector.RandomizeDuration = 1

# AHInjector.TargetHouses
#     Description: Comma-separated auction houses to inject into (0=Alliance, 1=Horde, 2=Neutral)
#     Default:     "0,1,2"
AHInjector.TargetHouses = "0,1,2"